# Copy to keystore.properties and fill in to produce a signed release build.
#
# Without it, `assembleRelease` still builds — it just leaves the APK unsigned rather than failing,
# so a fresh clone of this repo is not broken by a missing key.
#
# Forward slashes even on Windows: a backslash is an escape character in a .properties file.
storeFile=/absolute/path/to/lifeos-release.jks
storePassword=
keyAlias=lifeos
keyPassword=
