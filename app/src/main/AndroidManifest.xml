<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      LifeOS is local-first and offline-first: no internet, no account, no analytics. Everything
      lives in the app's private storage.

      These two are the ONLY permissions, and both exist for one feature — the daily reminders the
      user switches on themselves in 设置. Neither can send anything anywhere; there is still no
      INTERNET permission, so the app physically cannot talk to a network.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms do not survive a reboot. Without this, a phone restarted overnight silently stops
         reminding until the app is next opened by hand — which defeats the point of a reminder. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LifeOsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LifeOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Quick capture from the home-screen widget and the launcher shortcut. singleTop above
              means a second tap reuses the running instance and arrives via onNewIntent instead of
              stacking another copy of the app.
            -->
            <intent-filter>
                <action android:name="com.zk.lifeos.action.QUICK_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Tapping a reminder: the morning one opens 首页, the evening one opens 复盘. -->
            <intent-filter>
                <action android:name="com.zk.lifeos.action.OPEN_TODAY" />
                <action android:name="com.zk.lifeos.action.OPEN_REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.CaptureWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/capture_widget_info" />
        </receiver>

        <!--
          今日最重要 on the home screen. Unlike the capture widget this one shows data, so it is
          pushed updates by the app (see MitWidgetProvider) rather than polled by the system.
        -->
        <receiver
            android:name=".widget.MitWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mit_widget_info" />
        </receiver>

        <!--
          Daily reminders. The alarms target this receiver by explicit component, so the filter is
          only for the two system broadcasts that mean "your alarms are gone, set them again".
          exported="false" is correct even so: protected system broadcasts still reach it.
        -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
