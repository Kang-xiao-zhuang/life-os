<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: a calm ring with a centred dot — "one core, orbited by the parts of a life".
  Authored as a vector so the whole project stays text-only (no binary assets to lose track of).
  108x108 viewport; the meaningful shape stays inside the inner 72dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer ring -->
    <path
        android:pathData="M54,32 a22,22 0 1,1 -0.01,0 Z"
        android:strokeColor="#93B7F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- centre dot -->
    <path
        android:pathData="M54,48 a6,6 0 1,1 -0.01,0 Z"
        android:fillColor="#9FD8CB" />
</vector>
