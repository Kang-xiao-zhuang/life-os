<?xml version="1.0" encoding="utf-8"?>
<!--
  Widgets don't inherit the app theme, so this fixes the dark card look on any home screen
  wallpaper. Corner radius matches the app's card shape (16dp).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/widget_outline" />
</shape>
