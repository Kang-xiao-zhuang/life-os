<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy First: LifeOS data never leaves the device automatically. Cloud backup and
  device-to-device transfer are both disabled — the user moves data via the app's own
  export/import (LifeOS_Backup.zip) and nothing else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
